# Copy to .env (git-ignored), fill in what you need, then load it into your shell:
#   set -a
#   source .env
#   set +a
# cmsteer reads these from the environment; it does not read .env itself.

# Concept-rate judge (cmsteer judge). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model checkpoints. Only the models you run are needed.
# UniAR: a local copy of ShareLab-SII/UniAR-RL (default: download from the Hub)
UNIAR_CKPT=
# Liquid: checkpoint, and the folder holding vqgan.yaml and vqgan.ckpt
LIQUID_CKPT=
LIQUID_VQGAN_DIR=
# Emu3.5: a checkout of github.com/baaivision/Emu3.5, the weights, and the vision tokenizer
EMU35_REPO=
EMU35_CKPTS=
EMU35_VAE=

# Optional. Where released artifacts are downloaded (default ~/.cache/cmsteer)
CMSTEER_DATA=
# Optional. Hugging Face namespace to read the release from, if you use a mirror
CMSTEER_HF_NAMESPACE=
